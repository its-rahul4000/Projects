# Application secret key — signs session tokens / itsdangerous payloads (required).
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=

# ── SMTP (optional) ─────────────────────────────────────────────────────────────
# Enables the "Email Report" feature. PDF download always works without SMTP.
# For Gmail, use a 16-character App Password (NOT your account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sample@example.com
SMTP_PASS=
SMTP_FROM_NAME=Cybersecurity Log Intelligence System

# Max concurrent analysis worker processes (default: CPU count - 1, capped at 8).
ANALYSIS_MAX_WORKERS=8
# Set to 0 to force in-process analysis (debugging only).
USE_WORKER_PROCESS=1

